# SIMDA — Environment Configuration Template
# Copy this file to .env and configure your local environment credentials.
# NEVER commit .env to version control.

APP_NAME="SIMDA"
APP_FULL_NAME="Somali Islamic Microfinance Development Association"
APP_TAGLINE="Building Trust. Empowering Growth."
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/SIMDA
APP_TIMEZONE=Africa/Mogadishu
DEFAULT_LOCALE=en

# Database Configuration (MySQL 8+ / MariaDB 10.11+ InnoDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=simda_db
DB_TEST_DATABASE=simda_test_db
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Security & Session Configuration
SESSION_LIFETIME=3600
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
CSRF_TOKEN_SECRET=replace_with_a_64_character_cryptographic_random_hex_string

# Financial & Governance Defaults
APPROVAL_OFFICER_LIMIT=5000.00
APPROVAL_BRANCH_LIMIT=50000.00
LATE_CHARGE_GRACE_DAYS=7
DEFAULT_CHARITY_LATE_FEE=15.00
CREDIT_SCORE_INITIAL=600
CREDIT_SCORE_MIN=300
CREDIT_SCORE_MAX=850
DISBURSEMENT_EXPIRY_DAYS=30


# Outgoing mail (Gmail SMTP: use a Google App Password, never your normal password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME="SIMDA Somali Islamic Microfinance"

# SIMDA AI website assistant (Claude). Leave the key empty to use the built-in offline answers.
# Run `composer install` once so vendor/ exists.
ANTHROPIC_API_KEY=
SIMDA_AI_MODEL=claude-opus-5-5

# WhatsApp notifications via Maytapi (https://console.maytapi.com).
# Every email is also sent to the recipient's WhatsApp when their phone is on file.
WHATSAPP_ENABLED=false
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_API_TOKEN=
